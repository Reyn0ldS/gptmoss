{
  "schema_version": 1,
  "application": "GPTMOSS",
  "entrypoints": [
    "main.py",
    "start.bat",
    "start.sh",
    "install.bat",
    "install.sh",
    "prepare-offline-source.bat"
  ],
  "modules": {
    "gptmoss/api/server.py": "api",
    "gptmoss/capabilities/agent.py": "capability",
    "gptmoss/capabilities/devteam.py": "capability",
    "gptmoss/capabilities/documents.py": "capability",
    "gptmoss/capabilities/filesystem.py": "capability",
    "gptmoss/capabilities/memory.py": "capability",
    "gptmoss/capabilities/shell.py": "capability",
    "gptmoss/core/adaptive.py": "runtime",
    "gptmoss/core/artifact_validation.py": "assurance",
    "gptmoss/core/artifacts.py": "documents",
    "gptmoss/core/constants.py": "runtime",
    "gptmoss/core/context.py": "memory",
    "gptmoss/core/corpus.py": "assurance",
    "gptmoss/core/delivery.py": "assurance",
    "gptmoss/core/delivery_package.py": "delivery",
    "gptmoss/core/document_quality.py": "assurance",
    "gptmoss/core/documents.py": "documents",
    "gptmoss/core/durable_io.py": "persistence",
    "gptmoss/core/event_bus.py": "runtime",
    "gptmoss/core/evolution.py": "skills",
    "gptmoss/core/execution.py": "runtime",
    "gptmoss/core/kernel.py": "runtime",
    "gptmoss/core/observability.py": "observability",
    "gptmoss/core/professional_delivery.py": "delivery",
    "gptmoss/core/scheduler.py": "reserved",
    "gptmoss/core/skills.py": "skills",
    "gptmoss/core/state.py": "persistence",
    "gptmoss/interfaces/capability.py": "contract",
    "gptmoss/interfaces/llm.py": "contract",
    "gptmoss/interfaces/memory.py": "contract",
    "gptmoss/interfaces/planner.py": "contract",
    "gptmoss/interfaces/policy.py": "contract",
    "gptmoss/memory/json_store.py": "memory",
    "gptmoss/memory/ram.py": "memory",
    "gptmoss/planners/simple.py": "planning",
    "gptmoss/policies/simple.py": "security",
    "gptmoss/providers/qwen.py": "provider"
  },
  "operational_files": [
    "scripts/browser_layout_audit.py",
    "scripts/configure_embedded_python.py",
    "scripts/analyze_impact.py",
    "scripts/find_python.bat",
    "scripts/generate_symbol_map.py",
    "scripts/prepare_offline_source.py",
    "scripts/prepare_offline_source_launcher.py",
    "scripts/prepare_portable_python.py",
    "scripts/run_delivery_benchmarks.py",
    "scripts/server_supervisor.py",
    "scripts/validate_application_map.py",
    "scripts/validate_document.py"
  ],
  "capabilities": {
    "agent": {
      "module": "gptmoss/capabilities/agent.py",
      "actions": ["spawn", "status", "execute_subtask"]
    },
    "devteam": {
      "module": "gptmoss/capabilities/devteam.py",
      "actions": ["approve_quality_gate", "build_project"]
    },
    "documents": {
      "module": "gptmoss/capabilities/documents.py",
      "actions": ["inventory", "search", "read", "read_chunk"]
    },
    "filesystem": {
      "module": "gptmoss/capabilities/filesystem.py",
      "actions": ["read", "write", "list_dir", "delete"]
    },
    "memory": {
      "module": "gptmoss/capabilities/memory.py",
      "actions": ["search", "propose"]
    },
    "shell": {
      "module": "gptmoss/capabilities/shell.py",
      "actions": ["execute"]
    }
  },
  "api_routes": [
    ["GET", "/", "get_gui"],
    ["GET", "/health", "health"],
    ["GET", "/api/runtime-control", "runtime_control"],
    ["GET", "/readiness", "readiness"],
    ["POST", "/executions", "submit_task"],
    ["GET", "/projects", "list_projects"],
    ["POST", "/projects", "create_project"],
    ["POST", "/artifacts", "upload_artifact"],
    ["GET", "/artifacts", "list_artifacts"],
    ["GET", "/artifacts/search", "search_artifacts"],
    ["GET", "/artifacts/{artifact_id}/preview", "preview_artifact"],
    ["DELETE", "/artifacts/{artifact_id}", "delete_artifact"],
    ["POST", "/skills", "save_skill"],
    ["POST", "/skills/import", "import_skill"],
    ["POST", "/skills/{name}/validate", "validate_skill"],
    ["DELETE", "/skills/{name}", "delete_skill"],
    ["GET", "/memory", "list_memory"],
    ["POST", "/memory", "create_memory"],
    ["PUT", "/memory/{memory_id}", "update_memory"],
    ["POST", "/memory/{memory_id}/validate", "validate_memory"],
    ["DELETE", "/memory/{memory_id}", "delete_memory"],
    ["GET", "/skills", "list_skills"],
    ["GET", "/agent-profiles", "list_agent_profiles"],
    ["GET", "/evolution", "evolution_status"],
    ["GET", "/executions", "list_executions"],
    ["GET", "/executions/{execution_id}", "get_execution"],
    ["GET", "/executions/{execution_id}/delivery", "get_execution_delivery"],
    ["GET", "/executions/{execution_id}/subagents", "list_subagents"],
    ["POST", "/executions/{execution_id}/subagents", "create_subagent"],
    ["GET", "/api/diagnostics", "get_diagnostics"],
    ["GET", "/executions/{execution_id}/metrics", "get_execution_metrics"],
    ["GET", "/executions/{execution_id}/unified-feed", "get_unified_feed"],
    ["POST", "/executions/{execution_id}/approve", "approve_execution"],
    ["POST", "/executions/{execution_id}/reject", "reject_execution"],
    ["POST", "/executions/{execution_id}/pause", "pause_execution"],
    ["POST", "/executions/{execution_id}/resume", "resume_execution"],
    ["POST", "/executions/{execution_id}/cancel", "cancel_execution"],
    ["DELETE", "/executions/{execution_id}", "delete_execution"],
    ["POST", "/executions/clear-all", "clear_all_executions"],
    ["WEBSOCKET", "/ws/events", "ws_events"],
    ["WEBSOCKET", "/ws/executions/{execution_id}", "ws_execution_events"],
    ["GET", "/api/audit", "get_audit"],
    ["POST", "/api/settings/reveal-secret", "reveal_secret"],
    ["GET", "/api/settings", "get_settings"],
    ["POST", "/api/settings/test-connection", "test_connection"],
    ["POST", "/api/settings", "update_settings"]
  ],
