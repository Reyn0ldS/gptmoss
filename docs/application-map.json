    "PlanGenerated",
    "ProjectCreated",
    "ScopeApprovalRequested",
    "ScopeApproved",
    "StaleDelegatedApprovalCleared",
    "StepCompleted",
    "StepFailed",
    "StepQualityImproved",
    "StepRetryScheduled",
    "StepStarted",
    "TaskCreated",
    "TaskDeleted",
    "TasksCleared",
    "ToolCalled",
    "ToolCompleted",
    "ToolReused",
    "ValidationRepairHandoff"
  ],
  "execution_statuses": [
    "pending",
    "running",
    "paused",
    "waiting_provider",
    "cancelled",
    "completed",
    "failed"
  ],
  "configuration_fields": [
    "api_key",
    "base_url",
    "model_name",
    "vision_mode",
    "ssl_verify",
    "ssl_cert_path",
    "denied_capabilities",
    "approval_required_capabilities",
    "workspace_full_autonomy",
    "continue_while_progress",
    "adaptive_resource_management",
    "strict_skill_capabilities",
    "allow_nested_delegation",
    "max_delegation_depth",
    "autonomous_specialization",
    "autonomous_skill_creation",
    "autonomous_skill_improvement",
    "skill_coverage_threshold",
    "max_autonomous_skills_per_execution",
    "workspace_path",
    "restrict_to_workspace",
    "allow_subfolders",
    "max_context_chars",
    "max_upload_bytes",
    "max_attachment_text_chars",
    "max_step_iterations",
    "max_step_retries",
    "safe_shell_mode",
    "shell_timeout_seconds",
    "shell_max_output_chars",
    "default_skills",
    "projects"
  ],
  "gui_surfaces": [
    {
      "id": "task-composer",
      "evidence": ["submitNewTask", "/executions", "/projects", "/artifacts"]
    },
    {
      "id": "execution-control",
      "evidence": ["pauseActiveExecution", "resumeActiveExecution", "cancelActiveExecution", "downloadActiveDelivery"]
    },
    {
      "id": "execution-observation",
      "evidence": ["setupWebSocket", "/ws/events", "/unified-feed", "fetchExecutionDetails"]
    },
    {
      "id": "library",
      "evidence": ["refreshLibrary", "/artifacts/search", "/memory", "/skills", "/api/diagnostics"]
    },
    {
      "id": "settings",
      "evidence": ["collectSettingsPayload", "/api/settings", "/api/settings/test-connection"]
    },
    {
      "id": "runtime-control",
      "evidence": ["initializeRuntimeControl", "/api/runtime-control", "refreshServerStatus", "serverAction"]
    }
  ],
  "persistence": [
    ["workspace/config.json", "active configuration"],
    ["workspace/state_store.json", "execution and conversation states"],
    ["workspace/memories.json", "governed long-term memory"],
    ["workspace/telemetry.jsonl", "local execution telemetry"],
    ["workspace/settings_audit.jsonl", "settings and secret access audit"],
    ["workspace/uploads", "attachments, normalized documents and index"],
    ["workspace/projects/<project_id>", "default project workspaces"],
    ["workspace/agents", "persistent specialist profiles"],
    ["workspace/skills", "user and generated skills"],
    ["workspace/evolution/events.jsonl", "skill evolution history"],
    ["<project>/.gptmoss/deliveries/<execution_id>", "professional delivery package"]
  ],
  "features": [
    {
      "id": "runtime-api-gui",
      "tests": ["tests/test_api.py", "tests/test_end_to_end_workflow.py", "tests/test_functional_coverage_contract.py"]
    },
    {
      "id": "planning-execution-lifecycle",
      "tests": ["tests/test_execution.py", "tests/test_lifecycle_chronology.py", "tests/test_planning_modes.py", "tests/test_general_runtime_adaptation.py", "tests/test_adaptive_autonomy.py"]
    },
    {
      "id": "provider-recovery",
      "tests": ["tests/test_provider_integration.py", "tests/test_runtime_improvements.py"]
    },
    {
      "id": "policy-tools-delegation",
      "tests": ["tests/test_policy.py", "tests/test_agent_and_memory.py", "tests/test_devteam.py"]
    },
    {
      "id": "documents-artifacts",
      "tests": ["tests/test_documents.py", "tests/test_document_capability.py", "tests/test_skills_and_artifacts.py"]
    },
    {
      "id": "memory-v2",
      "tests": ["tests/test_memory_v2.py"]
    },
    {
      "id": "document-quality-delivery",
      "tests": ["tests/test_document_quality.py", "tests/test_document_planner_fallback.py", "tests/test_professional_delivery.py", "tests/test_delivery_assurance.py", "tests/test_delivery_benchmarks.py", "tests/test_corpus.py"]
    },
    {
      "id": "skills-evolution",
      "tests": ["tests/test_autonomous_evolution.py"]
    },
    {
      "id": "events-observability",
      "tests": ["tests/test_event_bus.py"]
    },
    {
      "id": "server-supervision",
      "tests": ["tests/test_server_supervisor.py"]
    },
    {
      "id": "offline-portable-runtime",
      "tests": ["tests/test_offline_source_package.py", "tests/test_windows_portable_python.py"]
    },
    {
      "id": "documentation-cartography",
      "tests": ["tests/test_documentation_contract.py", "tests/test_application_map.py", "tests/test_symbol_map.py"]
    }
  ],
  "offline": {
    "runtime_directory": "python-3.13.14-embed-amd64",
    "requirements": "requirements-runtime.txt",
    "constraints": "constraints-runtime.txt",
    "manifest": "offline-runtime-manifest.json",
    "builder": "scripts/prepare_offline_source.py",
    "launcher": "scripts/prepare_offline_source_launcher.py",
    "required_repository_files": [
      "main.py",
      "gptmoss/api/gui.html",
      "gptmoss/api/server.py",
      "requirements-runtime.txt",
      "constraints-runtime.txt",
      "offline-runtime-manifest.json",
      "install.bat",
      "start.bat",
      "prepare-offline-source.bat",
      "docs/application-map.json",
      "docs/symbol-map.json",
      "scripts/find_python.bat",
      "scripts/analyze_impact.py",
      "scripts/configure_embedded_python.py",
      "scripts/generate_symbol_map.py",
      "scripts/prepare_offline_source.py",
      "scripts/prepare_offline_source_launcher.py",
