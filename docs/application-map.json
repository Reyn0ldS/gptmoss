    "ApprovalRequested",
    "ArtifactRescueRequested",
    "ArtifactRescued",
    "AutonomousSpecializationPrepared",
    "ContextBuilt",
    "DeliveryAssuranceCompleted",
    "DeliveryRepairScheduled",
    "ExecutionCancelled",
    "ExecutionCompleted",
    "ExecutionFailed",
    "ExecutionPaused",
    "ExecutionProviderRetry",
